# Copy to .env next to docker-compose.yml. Everything except secrets can also be set in the
# web UI (Settings), which then overrides these defaults.
# Secrets: prefer files (docker-compose.yml `secrets:`): every secret below also accepts
# <NAME>_FILE=/run/secrets/<file>, which keeps it out of `docker inspect`.

# --- required ---
ANTHROPIC_API_KEY=                       # or use a local model / another provider below
CAPTIONIZERR_WEBHOOK_KEY=                # random string; Sonarr/Radarr send it as ?apikey=
CAPTIONIZERR_LIBRARY_ROOTS=/data/media   # only videos under these paths (;-separated) are processed

# --- recommended ---
CAPTIONIZERR_LANGUAGES=                  # target languages, e.g. de or ru,uk (can be set in the UI)
CAPTIONIZERR_MONTHLY_CAP_USD=20          # new jobs pause at the cap
#CAPTIONIZERR_UI_PASSWORD=               # require a login (user "admin"); set it if anyone but you can reach the port

# --- *arr / media server (library view, Bazarr lookups, rescans) ---
#CAPTIONIZERR_SONARR_URL=http://sonarr:8989
#CAPTIONIZERR_SONARR_KEY=
#CAPTIONIZERR_RADARR_URL=http://radarr:7878
#CAPTIONIZERR_RADARR_KEY=
#CAPTIONIZERR_JELLYFIN_URL=http://jellyfin:8096
#CAPTIONIZERR_JELLYFIN_KEY=
#CAPTIONIZERR_JELLYFIN_PATH_MAP=/data/media/=/media/     # our prefix=Jellyfin's, ;-separated
#CAPTIONIZERR_PATH_MAP=                                 # *arr prefix=our prefix, if they differ

# --- sources ---
#CAPTIONIZERR_SOURCE_LANGS=en            # translate from, in order of preference
#CAPTIONIZERR_BAZARR_URL=http://bazarr:6767
#CAPTIONIZERR_BAZARR_KEY=

# --- sharing on OpenSubtitles (opt-in button in the editor) ---
#CAPTIONIZERR_OPENSUBTITLES_USER=
#CAPTIONIZERR_OPENSUBTITLES_PASSWORD=

# --- notifications (ntfy) ---
#CAPTIONIZERR_NTFY_URL=https://ntfy.sh
#CAPTIONIZERR_NTFY_TOPIC=
#CAPTIONIZERR_PUBLIC_URL=http://captionizerr.lan:8095/

# --- other providers ---
#CAPTIONIZERR_PROVIDER=ollama            # anthropic (default) | ollama | openai
#CAPTIONIZERR_OLLAMA_URL=http://ollama:11434
#CAPTIONIZERR_OLLAMA_MODEL=gemma3:27b
#CAPTIONIZERR_OPENAI_BASE_URL=https://api.openai.com/v1
#CAPTIONIZERR_OPENAI_API_KEY=
#CAPTIONIZERR_OPENAI_MODEL=
